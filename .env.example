# Copy to .env.local for local development. Never commit real values.
# Production/preview values are set in the Vercel project "acan".

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — never expose to the browser
SUPABASE_SECRET_KEY=

# WhatsApp Business number, international format without "+" or spaces (e.g. 235XXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Google AdSense publisher ID (ca-pub-XXXXXXXXXXXXXXXX). Leave empty to disable AdSense.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Secret used to hash IPs for rate limiting and ad event de-duplication
RATE_LIMIT_SALT=
