# Copy to .env.local for local development. Never commit real values.
# Production/preview values are set in the Vercel project "acan".

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — never expose to the browser
SUPABASE_SECRET_KEY=

# WhatsApp Business number, international format without "+" or spaces (e.g. 235XXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Google AdSense publisher ID (ca-pub-XXXXXXXXXXXXXXXX). Leave empty to disable AdSense.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Secret used to hash IPs and sign short-lived tokens (form fill time, ad impressions/clicks)
RATE_LIMIT_SALT=

# Server-only proof sent with public form inserts. The database stores only its SHA-256 fingerprint
# (private.app_secrets, name 'form_signing_sha256'). Rotate both together.
FORM_SIGNING_SECRET=
